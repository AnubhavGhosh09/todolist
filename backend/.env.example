# MongoDB connection string (Atlas or local).
# Local example:  mongodb://127.0.0.1:27017/todo_app
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/todo_app
MONGODB_URI=mongodb://127.0.0.1:27017/todo_app

# Port the API listens on (Render injects this automatically).
PORT=5000

# Comma-separated list of allowed frontend origins.
# Leave empty to allow all origins (fine for development).
# Production example: https://your-todo-app.netlify.app
CORS_ORIGIN=

# Set to "production" to hide error stacks in responses.
NODE_ENV=development
